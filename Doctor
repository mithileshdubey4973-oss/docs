2) Node.js (Express) — छोटे उपयोगी कोड पैकेज के साथ

ये कोड एक बुनियादी सर्वर बनाता है: /chat (चैट), /upload-report (रिपोर्ट अपलोड), /book-appointment (अपॉइंटमेंट)। रिपोर्ट फ़ाइलें लोकल में uploads/ में सेव होंगी; आप चाहें तो AWS S3 या किसी अन्य स्टोरेज पर बदल सकते हैं। नीचे के उदाहरण में OpenAI API कॉल के लिए जगह बनाई है — अगर आप किसी अन्य LLM/AI का उपयोग करना चाहें तो उसे बदलें।

सेटअप:

1. Node.js (v16+) चाहिए।


2. नई फ़ोल्डर में npm init -y चलाएँ।


3. npm install express multer axios dotenv करें।


4. .env फ़ाइल में OPENAI_API_KEY (यदि आप OpenAI इस्तेमाल कर रहे हैं) रखें — अन्यथा AI कॉल वाली लाइनें कमेंट करें या बदल दें।


5. नीचे का index.js बनाकर चलाएँ: node index.js



index.js

// index.js
require('dotenv').config();
const express = require('express');
const multer = require('multer');
const path = require('path');
const fs = require('fs');
const axios = require('axios');

const app = express();
app.use(express.json());

// simple in-memory DB (demo only)
const appointments = [];
const reports = [];

// Multer setup for uploads
const uploadDir = path.join(__dirname, 'uploads');
if (!fs.existsSync(uploadDir)) fs.mkdirSync(uploadDir);
const storage = multer.diskStorage({
  destination: function (req, file, cb) { cb(null, uploadDir); },
  filename: function (req, file, cb) {
    const unique = Date.now() + '-' + Math.round(Math.random()*1e9);
    cb(null, unique + '-' + file.originalname);
  }
});
const upload = multer({ storage });

// --- Helper: call to LLM (OpenAI style) ---
// Replace or adapt per your AI provider. This is a minimal example.
async function callLLM(prompt) {
  const key = process.env.OPENAI_API_KEY;
  if (!key) {
    // fallback: simple rule-based reply
    return `आपने लिखा: "${prompt}". (नोट: OpenAI API key सेट नहीं है — इसलिए यह एक डमी उत्तर है।)`;
  }
  try {
    const resp = await axios.post('https://api.openai.com/v1/chat/completions', {
      model: 'gpt-4o-mini', // उदाहरण — बदलें यदि ज़रूरी हो
      messages: [{ role: 'user', content: prompt }],
      max_tokens: 400
    }, {
      headers: { Authorization: `Bearer ${key}` }
    });
    return resp.data.choices?.[0]?.message?.content || 'क्षमा करें, उत्तर नहीं मिला।';
  } catch (err) {
    console.error('LLM error', err.response?.data || err.message);
    return 'क्षमा करें, मैं अभी उत्तर देने में असमर्थ हूँ।';
  }
}

// --- Endpoint: chat ---
app.post('/chat', async (req, res) => {
  const { userId, message } = req.body;
  if (!message) return res.status(400).json({ error: 'message required' });

  // Basic routing based on keywords (you can replace with intent detection via LLM)
  const lower = message.toLowerCase();
  if (lower.includes('अपॉइंटमेंट') || lower.includes('डॉक्टर')) {
    return res.json({ reply: 'डॉक्टर से अपॉइंटमेंट के लिए कृपया बताइए कि आप किस प्रकार के डॉक्टर से मिलना चाहेंगे (न्यूरोलॉजिस्ट / कार्डियोलॉजिस्ट / जनरल फिज़िशियन / आयुर्वेदिक).' });
  }
  if (lower.includes('रिपोर्ट') || lower.includes('अपलोड')) {
    return res.json({ reply: 'कृपया अपनी रिपोर्ट अपलोड करने के लिए /upload-report endpoint का उपयोग करें।' });
  }
  if (lower.includes('तनाव') || lower.includes('रिलैक्स')) {
    return res.json({ reply: 'क्या आप चाहेंगे कि मैं एक छोटा 5 मिनट रिलैक्सेशन सेशन चलाऊँ? (हाँ/नहीं)' });
  }

  // otherwise ask LLM for a reply
  const aiReply = await callLLM(`User (${userId}): ${message}\n\nReply in Hindi, concise, helpful and empathetic.`);
  res.json({ reply: aiReply });
});

// --- Endpoint: upload report ---
app.post('/upload-report', upload.single('report'), async (req, res) => {
  if (!req.file) return res.status(400).json({ error: 'report file required (field name: report)' });
  const record = {
    id: reports.length + 1,
    filename: req.file.filename,
    originalname: req.file.originalname,
    path: req.file.path,
    uploadedAt: new Date().toISOString()
  };
  reports.push(record);

  // Optionally run an OCR/analysis step or call LLM with extracted text.
  // For demo, we call LLM with a simple prompt:
  const summary = await callLLM(`Analyze this medical report filename: ${record.originalname}. Give a short Hindi summary and possible actionable advice (non-diagnostic).`);

  res.json({ message: 'Report uploaded', report: record, ai_summary: summary });
});

// --- Endpoint: book appointment ---
app.post('/book-appointment', (req, res) => {
  const { name, phone, doctorType, datetime } = req.body;
  if (!name || !phone || !doctorType || !datetime) return res.status(400).json({ error: 'missing fields: name, phone, doctorType, datetime required' });

  const appt = {
    id: appointments.length + 1,
    name, phone, doctorType, datetime,
    status: 'booked',
    createdAt: new Date().toISOString()
  };
  appointments.push(appt);
  res.json({ message: 'Appointment booked', appointment: appt });
});

// --- Simple endpoints to view stored data (for testing) ---
app.get('/appointments', (req, res) => res.json({ appointments }));
app.get('/reports', (req, res) => res.json({ reports }));

// Start server
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`HealthBot server running on port ${PORT}`));


